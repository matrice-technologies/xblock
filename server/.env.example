# SQLite file, relative to server/prisma/ (the Docker image uses file:/data/xblock.db)
DATABASE_URL="file:./xblock.db"

# Used to HMAC the extension's auth token into a user id. At least 32 random characters,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Keep it stable and private: changing it turns every existing user into a new, empty one.
XBLOCK_SECRET="change-me"

PORT=3000

# Interface to listen on. Keep 127.0.0.1 locally; the Docker image uses 0.0.0.0.
HOST=127.0.0.1

# Extension origins allowed to call the API (comma-separated), e.g. the Web Store build
# chrome-extension://mabmaplbljlpcabbdioomjilodkhaajj. Leave unset locally to allow any extension.
# ALLOWED_ORIGINS=

# Enables the /admin endpoints used by scripts/sync-faf-list.js to maintain curated lists.
# At least 32 random characters; leave unset to disable /admin entirely.
# ADMIN_TOKEN=

# Number of reverse proxies in front of the server (1 behind Coolify/Traefik).
# Leave unset when clients connect directly, or they can spoof their IP past the rate limits.
# TRUST_PROXY=1
