{
  "name": "xblock-server",
  "description": "API + Prisma (SQLite) database for the XBlock extension",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:prod": "prisma migrate deploy && node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "seed:list": "node scripts/seed-list.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "prisma": "^6.19.3"
  }
}
