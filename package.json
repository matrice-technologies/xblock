    "copy-webpack-plugin": "^10.2.4",
    "html-webpack-plugin": "^5.6.3",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.98.0",
    "webpack-cli": "^4.10.0",
    "webpack-merge": "^5.10.0"
  }
}
